{
  "name": "granulab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run asm:build && vite build",
    "preview": "vite preview",
    "asm:build": "asc --config asconfig.json --target release",
    "parity": "npm run asm:build && npx esbuild tools/parity.ts --bundle --format=esm --platform=node --outfile=tools/parity.mjs && node tools/parity.mjs"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.20",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "@vercel/blob": "^2.7.0"
  }
}
